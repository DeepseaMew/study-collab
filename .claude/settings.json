{
  "permissions": {
    "allow": [
      "Edit(lib/**)",
      "Edit(packages/**)",
      "Edit(test/**)",
      "Edit(integration_test/**)",
      "Edit(firestore.rules)",
      "Edit(storage.rules)",
      "Edit(firebase.json)",
      "Edit(.firebaserc)",
      "Edit(docs/**)",
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(firebase emulators:*)",
      "Bash(firebase deploy --only firestore:rules,storage:*)",
      "Bash(flutterfire configure:*)",
      "Bash(fastlane:*)",
      "Bash(git tag:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Edit(**/*.g.dart)",
      "Edit(**/*.freezed.dart)",
      "Edit(lib/firebase_options.dart)",
      "Edit(ios/Pods/**)",
      "Edit(android/app/build/**)",
      "Edit(generated_plugin_registrant.*)",
      "Bash(git push --force*)",
      "Bash(rm -rf*)",
      "Bash(firebase deploy --only hosting:*)",
      "Bash(firebase deploy --only functions:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "command": "dart format ${tool.filePath}"
      },
      {
        "matcher": "Edit",
        "command": "tools/scan_secrets.sh ${tool.filePath}"
      }
    ],
    "PreCommit": [
      { "command": "flutter analyze --fatal-warnings" },
      { "command": "flutter test --coverage" },
      { "command": "firebase emulators:exec --only firestore 'flutter test test/rules/'" }
    ]
  },
  "mcpServers": {
    "firebase": {
      "command": "mcp-firebase",
      "args": ["--project", "study-collab", "--readonly"]
    },
    "github": {
      "command": "mcp-github",
      "args": ["--repo", "study-collab"]
    }
  }
}
